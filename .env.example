# === LLM Provider API Keys ===
# You only need to enter the keys for the providers you plan to use
GOOGLE_GENERATIVE_AI_API_KEY=****
OPENROUTER_API_KEY=****
# Optional fallback keys for OpenRouter (used when primary key hits rate limits)
# OPENROUTER_API_KEY_2=****
# OPENROUTER_API_KEY_3=****
GROQ_API_KEY=****
GROQ_BASE_URL=https://api.groq.com/openai/v1
# === Flare AI (api.flare-sh.tech) ===
# Fully OpenAI-compatible provider for Claude, Gemini, Deepseek, Qwen, Llama, Mistral, Grok, and more.
# Get your key from https://api.flare-sh.tech
# Usage: Set provider to "flare" in the model selector.
# If you were using KORE_API_KEY before, rename it to FLARE_API_KEY (both are supported).
FLARE_API_KEY=

# === NVIDIA NIM API Key ===
# Used by parallel provider (cloud.flare-sh.tech) for Gemini, Claude, GPT via NVIDIA NIM
# Get your key from https://developer.nvidia.com/nim
NVIDIA_API_KEY=

# Z AI (GLM models)
ZAI_API_KEY=****
ZAI_BASE_URL=https://api.z-ai.io/v1


# (Optional) Default model to use when none is specified
# Format: provider/model (e.g., openRouter/qwen3-8b:free)
E2E_DEFAULT_MODEL=


# === Database ===
# If you don't have PostgreSQL running locally, start it with: pnpm docker:pg
POSTGRES_URL=postgres://your_username:your_password@localhost:5432/your_database_name

# Secret for Better Auth (generate with: npx @better-auth/cli@latest secret)
BETTER_AUTH_SECRET=****
# Separate short-lived JWT signing secret for public embed sessions.
EMBED_JWT_SECRET=
# Auth session lifetime in seconds (default in code: 30 days)
AUTH_SESSION_EXPIRES_IN_SECONDS=2592000
# How often active sessions refresh expiry (default in code: 1 day)
AUTH_SESSION_UPDATE_AGE_SECONDS=86400
# Better Auth cookie cache max age in seconds (default in code: 1 hour)
AUTH_SESSION_COOKIE_CACHE_MAX_AGE_SECONDS=3600

# Cloudflare Turnstile (required for anti-bot/captcha validation)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Chat request guard secret (HMAC for challenge/session token binding)
# If empty, BETTER_AUTH_SECRET is used as fallback.
CHAT_REQUEST_GUARD_SECRET=

# AES-256-GCM master key for encrypting admin-managed provider/API keys.
# REQUIRED (exactly 32 chars) — admin endpoints that store secrets (e.g.
# /api/admin/providers POST, /api/admin/api-keys POST) return
# "Encryption not configured" when this is missing or wrong length.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url').slice(0,32))"
ENCRYPTION_MASTER_KEY=

# (IMPORTANT for Production)
# URL for the app - REQUIRED for OAuth callbacks (Gmail connector, MCP OAuth, etc.)
# For production, set this to your domain (e.g., https://yourdomain.com)
# Without this, OAuth redirect URIs will incorrectly use localhost!
FLARE_AUTH_URL=

# (Optional)
# === Tools === 
# Exa AI for web search and content extraction (optional, but recommended for @web and research features)
EXA_API_KEY=
# Firecrawl Browser Sandbox key for browser Agent tool (live browser sessions)
FIRECRAWL_API_KEY=
# YouTube Data API v3 key for YouTube search tool (optional)
YOUTUBE_API_KEY=
# Supadata API key for YouTube transcript tool (optional)
SUPADATA_API_KEY=
# KonvO key for speech + Vision OCR ingestion (optional)
KONVO_AI_API=
# Optional dedicated key for OCR (falls back to KONVO_AI_API when empty)
KONVO_OCR_API_KEY=



# ========================================================================
# === OPTIONAL SETTINGS BELOW (not required for basic functionality) ===
# ========================================================================


# (Optional) Redis for Multi-Instance Support
# When running multiple server instances (load balancing, clustering):
# - With Redis: Real-time MCP synchronization + reduced polling
# - Without Redis: Polling-only synchronization (single instance or dev mode)
# redis://localhost:6379
REDIS_URL=
# Optional Upstash REST fallback (works without REDIS_URL / TCP Redis URL)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# (Optional)
# Whether to use file-based MCP config (default: false)
FILE_BASED_MCP_CONFIG=false

# (Optional) 
# === OAuth Settings ===
# Fill in these values only if you want to enable Google/GitHub/Microsoft login

#GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

#Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to 1 to force account selection
GOOGLE_FORCE_ACCOUNT_SELECTION=


# Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional Tenant Id
MICROSOFT_TENANT_ID=
# Set to 1 to force account selection
MICROSOFT_FORCE_ACCOUNT_SELECTION=

# Slack (connector + inbound webhook)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Required to verify inbound Slack events (https://api.slack.com/authentication/verifying-requests-from-slack).
SLACK_SIGNING_SECRET=
# Optional legacy verification token (https://api.slack.com/legacy/legacy-verification-tokens).
SLACK_VERIFICATION_TOKEN=

# Notion
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# (Optional)
# === Gmail Connector ===
# Gmail connector reuses the existing GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET above.
# To enable Gmail integration:
# 1. Enable Gmail API in Google Cloud Console: https://console.cloud.google.com/apis/library/gmail.googleapis.com
# 2. Add this redirect URI to your OAuth client: {FLARE_AUTH_URL}/api/connectors/gmail/callback
# Required Gmail API scopes are automatically requested during user connection.

# (Optional)
# Set this to 1 to disable email sign in
DISABLE_EMAIL_SIGN_IN=

# (Optional)
# Set this to 1 to disable user sign-ups.
DISABLE_SIGN_UP=

# (Optional) Chat request guard controls
# Enabled by default in production and disabled by default in development.
CHAT_REQUEST_GUARD_ENABLED=
# Guard profile: balanced (recommended) or strict.
CHAT_REQUEST_GUARD_PROFILE=balanced
# Captcha mode: adaptive (recommended), always, or off.
CHAT_REQUEST_GUARD_CAPTCHA_MODE=adaptive
# In adaptive mode, enable captcha after this many challenge issues/min/IP.
CHAT_REQUEST_GUARD_CAPTCHA_ESCALATION_THRESHOLD=
# Skip repeated captcha checks for a verified user/session/IP during this window.
CHAT_REQUEST_GUARD_CAPTCHA_GRACE_MS=
# Session binding mode: off, soft (captcha on session IP/UA drift), or strict (reject drift).
CHAT_REQUEST_GUARD_SESSION_BINDING_MODE=soft
# Require captcha (Turnstile) on each guarded chat request.
CHAT_REQUEST_GUARD_REQUIRE_CAPTCHA=
# Challenge token lifetime in milliseconds.
CHAT_REQUEST_GUARD_CHALLENGE_TTL_MS=
# PoW difficulty (leading zero bits) baseline and escalated level.
CHAT_REQUEST_GUARD_POW_DIFFICULTY_BASE=
CHAT_REQUEST_GUARD_POW_DIFFICULTY_HIGH=
# Escalate PoW difficulty when challenge issue rate exceeds this per minute per IP.
CHAT_REQUEST_GUARD_POW_ESCALATION_THRESHOLD=
# Maximum PoW solve time window exposed to clients (milliseconds).
CHAT_REQUEST_GUARD_POW_MAX_SOLVE_MS=
# Rate limits
CHAT_REQUEST_GUARD_MAX_CHALLENGES_PER_MINUTE_PER_IP=
CHAT_REQUEST_GUARD_MAX_REQUESTS_PER_MINUTE_PER_USER=
CHAT_REQUEST_GUARD_MAX_REQUESTS_PER_MINUTE_PER_IP=
CHAT_REQUEST_GUARD_MAX_REQUESTS_PER_10S_PER_USER=

# (Optional)
# Set this to 1 to disallow adding MCP servers.
NOT_ALLOW_ADD_MCP_SERVERS=

# (Optional) MCP timeouts (milliseconds)
# How long to wait when connecting to an MCP server (default: 30000)
MCP_CONNECT_TIMEOUT=
# How long to wait for an individual MCP tool call before failing (default: 45000)
MCP_TOOL_TIMEOUT=
# Maximum total timeout for MCP client requests (e.g., connect/listTools) (default: 60000)
MCP_MAX_TOTAL_TIMEOUT=

# (Optional) KonvO Vision OCR tuning
# Max number of attachments to OCR per message (default: 3)
KONVO_OCR_MAX_ATTACHMENTS=
# Poll interval while waiting for OCR job completion (default: 1800)
KONVO_OCR_POLL_INTERVAL_MS=
# Max wait time for OCR completion per file (default: 45000)
KONVO_OCR_MAX_WAIT_MS=
# Truncate OCR text after this many characters (default: 12000)
KONVO_OCR_MAX_TEXT_CHARS=


# === File Storage ===

# -- Vercel Blob example --
# Pull the token locally with `vercel env pull` when testing against Vercel Blob.
# FILE_STORAGE_TYPE=vercel-blob
# FILE_STORAGE_PREFIX=uploads
# BLOB_READ_WRITE_TOKEN=


# -- S3 --
# FILE_STORAGE_TYPE=s3
# FILE_STORAGE_PREFIX=uploads
# FILE_STORAGE_S3_BUCKET=
# FILE_STORAGE_S3_REGION=
# Optional: Use when serving files via CDN/custom domain
# FILE_STORAGE_S3_PUBLIC_BASE_URL=https://cdn.example.com
# Optional: For S3-compatible endpoints (e.g., MinIO)
# FILE_STORAGE_S3_ENDPOINT=http://localhost:9000
# Optional: Force path-style URLs (1/true to enable)
# FILE_STORAGE_S3_FORCE_PATH_STYLE=1


# AWS Credentials (server only)
# The AWS SDK automatically discovers credentials in this order:
# 1) Environment variables below, 2) ~/.aws/credentials or AWS_PROFILE,
# 3) IAM role attached to the runtime (EC2/ECS/EKS/Lambda).
# You do NOT need to set these when using an IAM role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1

# === Community (separate Firebase Realtime Database + media storage) ===
# Public Firebase web config for the Community client SDK.
NEXT_PUBLIC_COMMUNITY_FIREBASE_API_KEY=
NEXT_PUBLIC_COMMUNITY_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_COMMUNITY_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_COMMUNITY_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_COMMUNITY_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_COMMUNITY_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_COMMUNITY_FIREBASE_APP_ID=
# Custom Community media storage API. Keep the bearer token server-side only.
COMMUNITY_STORAGE_BASE_URL=
COMMUNITY_STORAGE_API_KEY=
COMMUNITY_STORAGE_FOLDER_NAME=flare_community

# === AI App Builder (E2B Sandbox) ===
# Required for the Build tool - AI creates full-stack web apps in a cloud sandbox
# E2B_API_KEY=your-e2b-api-key

# === Resend Email (Region-Based) ===
# Each key maps to a regional sender domain ({region}.flare-sh.tech).
# At minimum, set RESEND_API_KEY_US as the fallback.
RESEND_API_KEY_US=
RESEND_API_KEY_IN=
RESEND_API_KEY_CHIN=
RESEND_API_KEY_EU=
RESEND_API_KEY_AUSTRALIA=
RESEND_API_KEY_SINGAPORE=
RESEND_API_KEY_BRAZIL=

# === Dodo Payments (Plan Upgrades) ===
# Self-service plan upgrades use Dodo Payments. Create products for each
# paid tier in the Dodo dashboard and paste the IDs below.
# Get the API key + webhook secret from https://app.dodopayments.com
# Self-service plan upgrades are automatically disabled when these are
# not set; admins can still change plans manually.
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
# test_mode uses https://test.dodopayments.com; live_mode uses the live URL.
DODO_ENVIRONMENT=test_mode
# Map each paid tier to its Dodo product ID (create one subscription
# product per paid tier in the Dodo dashboard):
DODO_PRODUCT_FLARE_PRO=
DODO_PRODUCT_FLARE_MAX=
DODO_PRODUCT_FLARE_ENTERPRISES=
DODO_PRODUCT_FLARE_ENTERPRISES_PRO=
DODO_PRODUCT_FLARE_ENTERPRISES_MAX=

# === Stripe (Plan Upgrades — P4.B) ===
# Self-service plan upgrades can also run on Stripe as an alternative
# to Dodo. Create one subscription product per paid tier in the
# Stripe dashboard and paste the price IDs below.
# Get the API key + webhook secret from https://dashboard.stripe.com/apikeys
# and https://dashboard.stripe.com/webhooks. The webhook signing
# secret is required — without it, /api/stripe/webhook returns 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Map each paid tier to its Stripe price ID (price_… from the
# Stripe dashboard, one per paid tier). Empty values disable that
# tier in the checkout UI.
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=


# Voicebox (self-hosted OSS voice I/O, https://github.com/jamiepine/voicebox)
# When set, the KonvO TTS/STT routes try Voicebox first, falling back to KonvO.
VOICEBOX_BASE_URL=https://api-voice.flare-labs.tech
VOICEBOX_PROFILE_ID=

# Sarvam AI Proxy for voice TTS/STT (self-hosted, konvo.flare-labs.tech)
SARVAM_PROXY_URL=https://konvo.flare-labs.tech
# Mandatory API key — must match SARVAM_PROXY_API_KEYS on the proxy service
SARVAM_PROXY_API_KEY=
# Voice chat LLM model (Flare AI). Fast model recommended for realtime voice.
VOICE_CHAT_MODEL=oc/deepseek-flash
